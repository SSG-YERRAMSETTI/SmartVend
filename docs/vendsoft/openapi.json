  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      },
      "basic_auth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "productCode": {
            "description": "Product SKU (should be unique)",
            "type": "string",
            "minLength": 1,
            "example": "COKE01"
          },
          "productName": {
            "description": "Product name",
            "type": "string",
            "minLength": 1,
            "example": "Coca Cola Can"
          },
          "productType": {
            "description": "Product type (category)",
            "type": "string",
            "minLength": 1,
            "example": "Cold Drinks"
          },
          "barcode": {
            "description": "Barcode",
            "type": "string",
            "example": "5449000000996"
          },
          "unitsPerCase": {
            "description": "Number of items in a case / box",
            "type": "integer",
            "example": 24
          },
          "lastCost": {
            "description": "Last cost",
            "type": "number",
            "format": "double"
          },
          "averageCost": {
            "description": "Average cost",
            "type": "number",
            "format": "double"
          }
        }
      },
      "Problem": {
        "type": "object",
        "additionalProperties": true,
        "minProperties": 1,
        "description": "The Problem Details JSON Object [[RFC7807](https://tools.ietf.org/html/rfc7807)].",
        "properties": {
          "type": {
            "type": "string",
            "description": "A URI reference [[RFC3986](https://tools.ietf.org/html/rfc3986)] that identifies the problem type. It should provide human-readable documentation for the problem type. When this member is not present, its value is assumed to be \"about:blank\".",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "description": "A short, human-readable summary of the problem type. It SHOULD NOT change from occurrence to occurrence of the problem, except for purposes of localization."
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code.",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "description": "A human-readable explanation specific to this occurrence of the problem."
          },
          "instance": {
            "type": "string",
            "description": "A URI reference that identifies the specific occurrence of the problem.  It may or may not yield further information if dereferenced."
          }
        }
      },
      "Machine": {
        "type": "object",
        "properties": {
          "machineCode": {
            "description": "Machine code (should be unique)",
            "type": "string",
            "minLength": 1,
            "example": "CD001"
          },
          "machineName": {
            "description": "Machine name",
            "type": "string",
            "minLength": 1,
            "example": "Soda machine first floor"
          },
          "machineType": {
            "description": "Machine type",
            "type": "string",
            "minLength": 1,
            "enum": [
              "Soda",
              "Snack",
              "Coffee",
              "Soda/Snack",
              "Snack/Coffee"
            ]
          },
          "machineModel": {
            "description": "Machine model",
            "type": "string",
            "example": "Dixie Narco"
          },
          "locationName": {
            "description": "Location name",
            "type": "string"
          }
        }
      },
      "Column": {
        "type": "object",
        "properties": {
          "column": {
            "description": "The item selection (should be unique)",
            "type": "string",
            "minLength": 1,
            "example": "A1"
          },
          "columnType": {
            "description": "The type of the column",
            "type": "string",
            "enum": [
              "soda",
              "drink",
              "ingredient"
            ]
          },
          "productCode": {
            "description": "Product SKU (should be unique)",
            "type": "string",
            "minLength": 1,
            "example": "COKE01"
          },
          "productName": {
            "description": "Product name",
            "type": "string",
            "minLength": 1,
            "example": "Coca Cola Can"
          },
          "productType": {
            "description": "Product type (category)",
            "type": "string",
            "minLength": 1,
            "example": "Cold Drinks"
          },
          "vendPrice": {
            "description": "Vend price",
            "type": "number",
            "format": "double"
          },
          "maxCapacity": {
            "description": "Capacity of the column",
            "type": "integer"
          },
          "lastCount": {
            "description": "The last fill level (for soda columns)",
            "type": "integer"
          }
        }
      },
      "RefillColumn": {
        "type": "object",
        "properties": {
          "column": {
            "description": "The item selection (should be unique)",
            "type": "string",
            "minLength": 1,
            "example": "A1"
          },
          "newProductCode": {
            "description": "The code of the new product (when replacing products, optional)",
            "type": "string"
          },
          "newPrice": {
            "description": "New price (when changing price, optional)",
            "type": "number",
            "format": "double"
          },
          "newCount": {
            "description": "The quantity after the refilling",
            "type": "integer"
          }
        }
      },
      "RefillMachine": {
        "type": "object",
        "properties": {
          "refillTime": {
            "description": "Timestamp of the refill",
            "type": "string",
            "format": "date-time",
            "example": "2023-07-12 07:20:50"
          },
          "driverEmail": {
            "description": "The email of the driver",
            "type": "string"
          },
          "driverUsername": {
            "description": "The username of the driver",
            "type": "string"
          },
          "cashCollected": {
            "description": "A flag showing whether the cash has been collected during the visit",
            "type": "boolean"
          },
          "cashCollectedAmount": {
            "description": "The cash collected from the machine",
            "type": "number",
            "format": "double"
          },
          "columns": {
            "description": "The item selection (should be unique)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RefillColumn"
            }
          }
        }
      },
      "TelemetrySale": {
        "type": "object",
        "properties": {
          "telemetryId": {
            "type": "string",
            "description": "Telemetry identifier",
            "example": "VK12345"
          },
          "transactionId": {
            "type": "integer",
            "format": "int64",
            "description": "Unique transaction identifier",
            "example": 126290169
          },
          "transactionTime": {
            "type": "string",
            "description": "Transaction timestamp in format yyyyMMddHHmmss",
            "pattern": "^\\d{14}$",
            "example": "20250610225908"
          },
          "productName": {
            "type": "string",
            "description": "Name of the product sold",
            "example": "Coca Cola Can"
          },
          "machineCode": {
            "type": "string",
            "description": "Machine code",
            "example": "CD001"
          },
          "productCode": {
            "type": "string",
            "description": "Product code",
            "example": "COKE01"
          },
          "creditCard": {
            "type": "string",
            "description": "Masked credit card number",
            "example": "*1234"
          },
          "quantity": {
            "type": "integer",
            "description": "Quantity sold",
            "example": 1
          },
          "selection": {
            "type": "string",
            "description": "Vending machine selection",
            "example": "62"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Sale price",
            "example": 1.2
          },
          "machineName": {
            "type": "string",
            "description": "Machine name",
            "example": "Cold drink 1"
          }
        },
        "required": [
          "telemetryId",
          "transactionId",
          "transactionTime",
          "machineCode",
          "quantity",
          "price"
        ]
      },
      "Location": {
        "type": "object",
        "properties": {
          "locationCode": {
            "description": "Location code (should be unique)",
            "type": "string",
            "minLength": 1,
            "example": "L001"
          },
          "locationName": {
            "description": "Location name",
            "type": "string",
            "minLength": 1,
            "example": "Casa Estates"
          },
          "addressLine1": {
            "description": "Address Line1",
            "type": "string"
          },
          "addressLine2": {
            "description": "Address Line2",
            "type": "string"
          },
          "city": {
            "description": "City",
            "type": "string"
          },
          "region": {
            "description": "State/Province",
            "type": "string"
          },
          "zipCode": {
            "description": "ZIP code",
            "type": "string"
          }
        }
      },
      "CreateTrip": {
        "type": "object",
        "required": [
          "delivery_date",
          "machineCodes"
        ],
        "properties": {
          "delivery_date": {
            "description": "Preferred delivery date field. The API also accepts `deliveryDate`. Supported formats are `yyyy-MM-dd`, `yyyy-MM-dd HH:mm:ss`, `yyyy-MM-dd'T'HH:mm:ss`, and `yyyy-MM-dd'T'HH:mm:ssZ`.",
            "type": "string",
            "example": "2026-04-06",
            "minLength": 1
          },
          "driverEmail": {
            "description": "Email of an existing driver for this customer.",
            "type": "string",
            "format": "email",
            "example": "driver@example.com"
          },
          "driverUsername": {
            "description": "Username of an existing driver for this customer.",
            "type": "string",
            "example": "jdoe"
          },
          "description": {
            "description": "Optional trip description.",
            "type": "string",
            "example": "Tuesday downtown route"
          },
          "machineCodes": {
            "description": "Preferred machine code array field. The API also accepts `machine_codes`.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "example": [
              "M-1001",
              "M-1002"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "driverEmail"
            ]
          },
          {
            "required": [
              "driverUsername"
            ]
          }
        ],
        "example": {
          "delivery_date": "2026-04-06",
          "driverEmail": "driver@example.com",
          "description": "Tuesday downtown route",
          "machineCodes": [
            "M-1001",
            "M-1002"
          ]
        }
      },
      "CreateTripResponse": {
        "type": "object",
        "required": [
          "tripNumber"
        ],
        "properties": {
          "tripNumber": {
            "description": "Numeric identifier of the created trip.",
            "type": "integer",
            "example": 12345
          }
        }
      },
      "PurchaseLineItem": {
        "type": "object",
        "properties": {
          "productCode": {
            "description": "Product SKU (should be unique)",
            "type": "string",
            "minLength": 1,
            "example": "COKE01"
          },
          "productName": {
            "description": "Product name",
            "type": "string",
            "minLength": 1,
            "example": "Coca Cola Can"
          },
          "productType": {
            "description": "Product type (category)",
            "type": "string",
            "minLength": 1,
            "example": "Cold Drinks"
          },
          "numberCases": {
            "description": "Number of cases",
            "type": "integer"
          },
          "costPerCase": {
            "description": "Cost per case",
            "type": "number",
            "format": "double"
          },
          "unitsPerCase": {
            "description": "Units per case",
            "type": "integer"
          },
          "numberUnits": {
            "description": "Number of units",
            "type": "integer"
          },
          "unitCost": {
            "description": "Unit cost",
            "type": "number",
            "format": "double"
          }
        }
      },
      "Purchase": {
        "type": "object",
        "properties": {
          "purchaseDate": {
            "description": "Date of the purchase",
            "type": "string",
            "format": "date",
            "example": "2023-07-12",
            "minLength": 1
          },
          "supplierName": {
            "description": "Name of the supplier",
            "type": "string",
            "minLength": 1
          },
          "invoiceNumber": {
            "description": "Invoice number",
            "type": "string",
            "minLength": 1
          },
          "shippingCost": {
            "description": "Shipping Cost",
            "type": "number",
            "format": "double"
          },
          "salesTax": {
            "description": "Sales Tax",
            "type": "number",
            "format": "double"
          },
          "lineItems": {
            "description": "Purchase line items",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchaseLineItem"
            }
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "machineCode": {
            "description": "Machine Code",
            "type": "string",
            "minLength": 1,
            "example": "CD001"
          },
          "problemType": {
            "description": "Problem Type",
            "type": "string",
            "minLength": 1,
            "example": "Refund/Machine Broken/Restock Required/Product Request/Other"
          },
          "description": {
            "description": "Description",
            "type": "string"
          },
          "clientEmail": {
            "description": "Client Email",
            "type": "string"
          },
          "clientPhone": {
            "description": "Client Phone",
            "type": "string"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Problem",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}