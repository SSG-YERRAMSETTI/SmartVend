    "/machines/{machineCode}/sales": {
      "get": {
        "tags": [
          "Machine"
        ],
        "summary": "Get telemetry sales",
        "description": "Get sales transactions from telemetry data for a specific machine.",
        "operationId": "getMachineSales",
        "parameters": [
          {
            "name": "machineCode",
            "in": "path",
            "description": "The code of the machine",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "description": "Start date in format yyyyMMddHHmmss",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{14}$",
              "example": "20250610000000"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "description": "End date in format yyyyMMddHHmmss",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^\\d{14}$",
              "example": "20250610235959"
            }
          }
        ],
        "security": [
          {
            "api_key": []
          },
          {
            "basic_auth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TelemetrySale"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Machine not found"
          }
        }
      }
    },
